// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model usuarios {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(100)
  apellido     String   @db.VarChar(100)
  telefono     String   @db.VarChar(15)
  password_hash String   @db.VarChar(255)
  email        String   @unique @db.VarChar(254)
  dni          String   @db.VarChar(10)
  provincia    String   @db.VarChar(100)
  localidad    String   @db.VarChar(100)
  direccion    String   @db.VarChar(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pedidos      pedidos[]
}

model pedidos {
  id              Int              @id @default(autoincrement())
  usuario_id      Int
  direccion_envio String           @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  costo_envio     Decimal          @db.Decimal(12, 2)

  usuario         usuarios         @relation(fields: [usuario_id], references: [id])
  detalles        detalles_pedido[]

}

model productos {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  descripcion String   @db.VarChar(255)
  precio      Decimal  @db.Decimal(12, 2)
  stock_s     Int      @default(0)
  stock_m     Int      @default(0)
  stock_l     Int      @default(0)
  stock_xl    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  detalles detalles_pedido[]
}

model detalles_pedido {
  id              Int      @id @default(autoincrement())
  pedido_id       Int
  producto_id     Int
  cantidad        Int
  talle           String   @db.VarChar(10)
  precio_unitario Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pedido   pedidos   @relation(fields: [pedido_id], references: [id])
  producto productos @relation(fields: [producto_id], references: [id])
}

